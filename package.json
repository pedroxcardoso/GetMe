{
  "name": "getme-pixel-downloader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Seu cantinho pixel art para guardar vídeos e músicas com autorização.",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "cross-env GETME_DEV_SERVER_URL=http://127.0.0.1:5174 concurrently -k \"vite --host 127.0.0.1 --port 5174\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "26.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.getme.desktop",
    "productName": "GETME",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "electron/assets/getme.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
